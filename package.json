{
  "name": "core-workflow-framework",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "version": "0.1.0",
  "description": "Unified slash-command workflow framework",
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "verify": "node scripts/verify.mjs",
    "commitlint": "commitlint",
    "test:versioning": "vitest run scripts/fleet-versioning"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@core/commitlint-config": "workspace:*",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "mysql2": "^3.22.0",
    "smol-toml": "^1.6.0"
  }
}
