# packages/<name>/.env.example: every key this package reads, committed WITHOUT values (adr:package-env-files).
# Copy to packages/<name>/.env (mode 600, never committed) and fill in the values there.
# Values here are blank or <placeholder> only; scripts/env-files-check.mjs fails CI otherwise.

# Where the service listens or connects. Not secret.
EXAMPLE_ENDPOINT=
# Path to a private file holding the access token (secret: the file, not this path).
EXAMPLE_TOKEN_FILE=<path to a mode-600 token file>
# Worker count, 1-32 (default 2).
EXAMPLE_WORKERS=
