  E(["Owning service<br/>Checks authority; commits effect/receipt"])
  X(["Receiving task<br/>Records concrete consumption"])
  W(["Original-work owner<br/>Records distinct disposition"])
  L(["Later distinct task<br/>Records cited reuse and result"])
  P["Evidence projection<br/>Source refs, revisions, freshness"]
